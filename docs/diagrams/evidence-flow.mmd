flowchart LR
    Source["Seeded source turns<br/>Facts, corrections, deletions"] --> Input["Source-only segment<br/>Messages and query keys"]
    Source -. "Independent expected revisions" .-> Ledger["Truth ledger<br/>GRADER ONLY"]
    Input --> Runtime["Fresh checkpoint worker<br/>MemoryManager + Uniichat"]
    Runtime --> Recall["Index and recall observations"]
    Runtime --> Compact["ContextCompressor<br/>Selected-input summary"]
    Compact --> DB[("SQLite + raw memory<br/>Active and archived evidence")]
    DB --> Restart["Separate fresh interpreter<br/>Reopen and probe"]
    Recall --> Grade["Independent grader<br/>Strict answers + planned denominators"]
    Compact -. "Before / after states" .-> Grade
    Restart --> Grade
    Ledger -. "Expected state, never adapter input" .-> Grade
    Grade --> Reports["JSON + CSV + HTML<br/>Matched comparisons and acceptance gates"]
    classDef source fill:#f5f2ec,stroke:#626f77,color:#18292d
    classDef real fill:#e1f0ef,stroke:#176370,color:#18292d
    classDef grader fill:#fff0cc,stroke:#ad6f16,color:#18292d
    class Source,Input,Reports source
    class Runtime,Recall,Compact,DB,Restart real
    class Ledger,Grade grader
