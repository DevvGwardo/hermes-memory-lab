# Track the reusable lab, never local historical audits or raw runs.
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/pyproject.toml
!/simulator.py
!/run-simulator.sh
!/memory_sim/
!/tests/
!/docs/
!/assets/
!/tools/
!/package.json
!/package-lock.json
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/.env
**/.env.*
/node_modules/
/runs/
/dist/
/build/
/*.egg-info/
